# Порт задаёт сам Render автоматически, но можно оставить для локального запуска
PORT=3000

# Фронтенд теперь раздаётся тем же сервисом (backend/public), поэтому
# CORS_ORIGIN обычно не нужен. Задайте его, только если открываете сокет
# ещё и с другого домена/локально во время разработки.
# CORS_ORIGIN=http://localhost:5500

# Строка подключения к облачному Redis (например, Upstash или Redis Cloud)
REDIS_URL=redis://default:password@your-redis-host:6379

# Весь JSON сервисного аккаунта Firebase одной строкой (см. README, раздел Firebase)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", "...": "..."}
